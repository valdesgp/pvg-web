<%- include('head.ejs') %>

<body>
  <!-- Blurred homepage background (decorative, not interactive) -->
  <div class="login-bg" aria-hidden="true" tabindex="-1" inert>
    <div class="overflow-x-hidden">
      <%- include('homepage-content.ejs') %>
    </div>
  </div>

  <!-- Login / request-access overlay -->
  <div class="login-overlay">

    <!-- Password panel -->
    <div id="password-panel" class="login-card">
      <div class="login-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/>
        </svg>
      </div>
      <p class="login-title font-main">This portfolio is private</p>
      <p class="login-subtitle">Enter the password to access the page.</p>

      <form method="POST" action="/login">
        <input class="glass-nav-b rounded-md border-solid border-2" type="password" name="password" placeholder="Password" autofocus required />
        <button class="submitform" type="submit">Enter</button>
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="login-error"><%= error %></div>
        <% } %>
      </form>

      <button type="button" id="show-request-panel" class="login-link">Don't have a password? Request access</button>
    </div>

    <!-- Request-access panel (hidden by default) -->
    <div id="request-panel" class="login-card" hidden>
      <div class="login-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M.05 3.555A2 2 0 0 1 2 2h12a2 2 0 0 1 1.95 1.555L8 8.414zM0 4.697v7.104l5.803-3.558zM6.761 8.83l-6.57 4.027A2 2 0 0 0 2 14h12a2 2 0 0 0 1.808-1.144l-6.57-4.027L8 9.586zm3.436-.586L16 11.801V4.697z"/>
        </svg>
      </div>
      <p class="login-title font-main">Request access</p>
      <p class="login-subtitle">Tell me a bit about yourself and I'll send you the password.</p>

      <form id="request-access-form">
        <input type="hidden" name="access_key" value="04401235-5250-464d-bf29-9d938d309924">
        <input type="hidden" name="subject" value="Portfolio Access Request">

        <input class="glass-nav-b rounded-md border-solid border-2" type="text" name="name" placeholder="Name" required>
        <input class="glass-nav-b rounded-md border-solid border-2" type="email" name="email" placeholder="Email Address" required>
        <textarea class="glass-nav-b rounded-md border-solid border-2" name="message" placeholder="Why would you like access?" required></textarea>

        <button class="submitform" type="submit">Send Request</button>
        <div id="request-error" class="login-error" hidden></div>
      </form>

      <div id="request-success" class="login-success" hidden>
        Thanks! Your request has been sent — I'll follow up by email with access.
      </div>

      <button type="button" id="show-password-panel" class="login-link">Back to password login</button>
    </div>

  </div>

  <style>
    html, body {
      overflow: hidden;
      height: 100%;
    }

    .login-bg {
      filter: blur(10px);
      transform: scale(1.02);
      pointer-events: none;
      user-select: none;
    }

    .login-overlay {
      position: fixed;
      inset: 0;
      z-index: 999;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      background: rgba(250, 250, 250, 0.55);
    }

    .login-card {
      width: 100%;
      max-width: 380px;
      padding: 2.25rem 2rem;
      border-radius: 14px;
      background: rgba(255, 255, 255, 0.6);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.6);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
      text-align: center;
    }

    .login-icon {
      width: 52px;
      height: 52px;
      margin: 0 auto 1rem;
      border-radius: 999px;
      background: rgba(68, 0, 145, 0.1);
      color: rgb(88, 0, 175);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .login-title {
      font-size: 1.4rem;
      font-weight: 600;
      color: #2D2D2D;
      margin-bottom: 0.35rem;
    }

    .login-subtitle {
      font-size: 0.9rem;
      color: rgba(45, 45, 45, 0.7);
      margin-bottom: 1.5rem;
    }

    .login-card form input,
    .login-card form textarea {
      margin-bottom: 0.75rem;
      font-size: 1rem;
      border-color: rgba(68, 0, 145, 0.15);
    }

    .login-card form textarea {
      min-height: 90px;
    }

    .login-card .submitform {
      cursor: pointer;
      border: none;
      margin-top: 0.25rem;
    }

    .login-error {
      color: #b91c1c;
      font-size: 0.85rem;
      margin-top: 0.75rem;
    }

    .login-success {
      color: #15803d;
      font-size: 0.9rem;
      margin-bottom: 1rem;
    }

    .login-link {
      display: inline-block;
      margin-top: 1.25rem;
      background: none;
      border: none;
      padding: 0;
      font-size: 0.85rem;
      color: rgb(88, 0, 175);
      text-decoration: underline;
      cursor: pointer;
    }
  </style>

  <script>
    document.getElementById('show-request-panel').addEventListener('click', function () {
      document.getElementById('password-panel').hidden = true;
      document.getElementById('request-panel').hidden = false;
    });

    document.getElementById('show-password-panel').addEventListener('click', function () {
      document.getElementById('request-panel').hidden = true;
      document.getElementById('password-panel').hidden = false;
    });

    document.getElementById('request-access-form').addEventListener('submit', async function (e) {
      e.preventDefault();
      const form = e.target;
      const errorEl = document.getElementById('request-error');
      const submitBtn = form.querySelector('button[type="submit"]');

      errorEl.hidden = true;
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form)
        });
        const result = await response.json();

        if (result.success) {
          form.hidden = true;
          document.getElementById('request-success').hidden = false;
        } else {
          throw new Error(result.message || 'Something went wrong.');
        }
      } catch (err) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send Request';
        errorEl.textContent = 'Could not send your request. Please try again or email hello@valdesgpatricio.com directly.';
        errorEl.hidden = false;
      }
    });
  </script>
</body>
</html>
